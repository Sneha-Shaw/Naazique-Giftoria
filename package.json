    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "mongodb": "^7.6.0",
    "nanostores": "^1.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
