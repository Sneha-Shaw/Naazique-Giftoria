# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database -------------------------------------------------------------
# Atlas M0, free forever. Use a database user scoped to readWrite on `giftshop`,
# NOT an admin user. Atlas network access must allow 0.0.0.0/0, because Netlify's
# build and function IPs are not fixed.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# --- Site -----------------------------------------------------------------
# Drives canonical URLs, OG tags and the sitemap. Set to the real Netlify URL.
PUBLIC_SITE_URL="https://example.netlify.app"

# --- Images ---------------------------------------------------------------
# PUBLIC_ is shipped to the browser — that is correct for the cloud name, which
# appears in every image URL anyway. The API key and secret are NOT public and
# are only used server-side (phase 2, for signed uploads).
PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Admin (phase 2) ------------------------------------------------------
# 32+ random bytes: openssl rand -base64 48
JWT_SECRET=""
# The Netlify build hook the "Publish to site" button calls.
BUILD_HOOK_URL=""
