---
import { coverOf, coverSrcSet } from '../lib/cloudinary.js';
import { formatINR, discountPercent } from '../lib/money.js';
import { isSoldOut } from '../lib/catalog.js';
import AddToCart from './AddToCart.jsx';

const { product, eager = false } = Astro.props;
const cover = coverOf(product, 800);
const off = discountPercent(product.price, product.mrp);
const soldOut = isSoldOut(product);
---
<article class="group flex flex-col overflow-hidden rounded-2xl border border-blush-100 bg-white transition hover:shadow-lg hover:shadow-blush-200/40">
  <a href={`/products/${product.slug}`} class="relative block overflow-hidden">
    <img
      src={cover}
      srcset={coverSrcSet(product)}
      sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 90vw"
      alt={product.images?.[0]?.alt ?? product.name}
      width="800"
      height="800"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      class="aspect-square w-full bg-blush-50 object-cover transition duration-300 group-hover:scale-[1.03]"
    />
    {off && !soldOut && (
      <span class="absolute left-3 top-3 rounded-full bg-blush-500 px-2.5 py-1 text-xs font-semibold text-white">
        {off}% off
      </span>
    )}
    {soldOut && (
      <span class="absolute inset-0 flex items-center justify-center bg-cream-50/80 text-sm font-semibold uppercase tracking-wide text-ink-700">
        Sold out
      </span>
    )}
  </a>

  <div class="flex flex-1 flex-col p-4">
    <h3 class="font-display text-base font-semibold leading-snug text-ink-900">
      <a href={`/products/${product.slug}`} class="hover:text-blush-600">{product.name}</a>
    </h3>
    {product.shortDesc && <p class="mt-1 line-clamp-2 text-sm text-ink-700">{product.shortDesc}</p>}

    <div class="mt-3 flex items-baseline gap-2">
      <span class="font-semibold text-ink-900">{formatINR(product.price)}</span>
      {product.mrp > product.price && (
        <span class="text-sm text-ink-700/60 line-through">{formatINR(product.mrp)}</span>
      )}
    </div>

    <div class="mt-4 flex items-center gap-2">
      {soldOut ? (
        <span class="text-sm text-ink-700/70">Currently unavailable</span>
      ) : (
        <AddToCart client:visible product={product} image={coverOf(product, 400)} />
      )}
      <a href={`/products/${product.slug}`} class="ml-auto text-sm font-medium text-blush-600 hover:underline">
        Details
      </a>
    </div>
  </div>
</article>
