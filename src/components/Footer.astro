---
import { settings } from '../lib/catalog.js';
import { enquiryLink } from '../lib/whatsapp.js';
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-blush-100 bg-cream-100">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-3">
    <div>
      <p class="font-display text-lg font-semibold text-blush-700">{settings.businessName}</p>
      <p class="mt-2 text-sm text-ink-700">{settings.tagline}</p>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink-900">Ordering</p>
      <ul class="mt-2 space-y-1 text-sm text-ink-700">
        <li><a class="hover:text-blush-600" href="/shop">Shop all bouquets</a></li>
        <li><a class="hover:text-blush-600" href="/build">Build your own</a></li>
        <li><a class="hover:text-blush-600" href="/about">Delivery &amp; FAQ</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink-900">Talk to us</p>
      <ul class="mt-2 space-y-1 text-sm text-ink-700">
        <li><a class="hover:text-blush-600" href={enquiryLink(settings.whatsappNumber)} target="_blank" rel="noopener">WhatsApp</a></li>
        {settings.instagramUrl && (
          <li><a class="hover:text-blush-600" href={settings.instagramUrl} target="_blank" rel="noopener">Instagram</a></li>
        )}
      </ul>
      {settings.deliveryAreas && <p class="mt-3 text-xs text-ink-700/80">{settings.deliveryAreas}</p>}
    </div>
  </div>
  <div class="border-t border-blush-100 px-4 py-4 text-center text-xs text-ink-700/70">
    © {year} {settings.businessName}. Prices shown are indicative and confirmed on WhatsApp before payment.
  </div>
</footer>
