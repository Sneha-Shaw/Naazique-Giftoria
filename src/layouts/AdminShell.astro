---
import '../styles/global.css';
import LogoutButton from '../components/admin/LogoutButton.jsx';
import { getLiveCatalog } from '../lib/catalog.js';

const { title, session } = Astro.props;
const { settings } = await getLiveCatalog();
const path = Astro.url.pathname;

const ICONS = {
  box: 'M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8',
  image: 'M3 3h18v18H3zM8.5 8.5a1.5 1.5 0 1 1 0 .01M21 15l-5-5L5 21',
  settings: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z',
  history: 'M12 8v5l3 3M3 12a9 9 0 1 0 3-6.7M3 3v5h5',
} as const;

// Typed against ICONS' own keys, so a typo'd icon name is a build-time error
// instead of a silently-missing SVG path.
const NAV: { href: string; label: string; icon: keyof typeof ICONS }[] = [
  { href: '/admin/products', label: 'Products', icon: 'box' },
  { href: '/admin/gallery', label: 'Gallery', icon: 'image' },
  { href: '/admin/settings', label: 'Settings', icon: 'settings' },
  { href: '/admin/history', label: 'History', icon: 'history' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title ? `${title} · Admin` : 'Admin'}</title>
  </head>
  <body class="min-h-screen bg-cream-50 font-sans antialiased">
    <div class="lg:flex">
      {/* Side nav — desktop only */}
      <aside class="hidden w-56 shrink-0 border-r border-blush-100 bg-white lg:block" style="padding-top: env(safe-area-inset-top, 0px)">
        <div class="flex items-center gap-2.5 p-5">
          <img src="/logo.png" alt="" width="36" height="36" class="h-9 w-9 shrink-0 rounded-full" />
          <div class="min-w-0">
            <p class="truncate font-display text-lg font-semibold text-blush-700">{settings.businessName ?? 'Naazique Giftoria'}</p>
            <p class="truncate text-xs text-ink-700/70">{session?.email}</p>
          </div>
        </div>
        <nav class="space-y-0.5 px-3">
          {NAV.map((item) => (
            <a
              href={item.href}
              aria-current={path.startsWith(item.href) ? 'page' : undefined}
              class:list={['flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition',
                path.startsWith(item.href) ? 'bg-blush-100 text-blush-700' : 'text-ink-700 hover:bg-cream-100']}
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={ICONS[item.icon]} />
              </svg>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="p-3">
          <LogoutButton client:load className="w-full rounded-xl px-3 py-2.5 text-left text-sm font-medium text-ink-700 hover:bg-cream-100" />
        </div>
      </aside>

      <div class="min-h-screen flex-1">
        {/* Top bar — mobile only */}
        <header class="sticky top-0 z-20 flex items-center justify-between border-b border-blush-100 bg-cream-50/95 px-4 py-3 backdrop-blur lg:hidden" style="padding-top: calc(0.75rem + env(safe-area-inset-top, 0px))">
          <p class="font-display text-base font-semibold text-blush-700">{title ?? 'Admin'}</p>
          <LogoutButton client:load className="text-sm font-medium text-ink-700 underline" />
        </header>

        <main class="px-4 py-6 pb-24 lg:px-8 lg:py-8 lg:pb-8">
          <slot />
        </main>
      </div>
    </div>

    {/* Bottom tab bar — mobile only. She will update prices from her phone, so this is the primary nav, not an afterthought. */}
    <nav
      class="fixed inset-x-0 bottom-0 z-20 grid grid-cols-4 border-t border-blush-100 bg-white lg:hidden"
      style="padding-bottom: env(safe-area-inset-bottom, 0px)"
      aria-label="Admin sections"
    >
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={path.startsWith(item.href) ? 'page' : undefined}
          class:list={['flex flex-col items-center gap-0.5 py-2 text-[11px] font-medium',
            path.startsWith(item.href) ? 'text-blush-600' : 'text-ink-700/70']}
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={ICONS[item.icon]} />
          </svg>
          {item.label}
        </a>
      ))}
    </nav>
  </body>
</html>
