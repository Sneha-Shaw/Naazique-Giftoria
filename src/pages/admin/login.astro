---
import '../../styles/global.css';
import LoginForm from '../../components/admin/LoginForm.jsx';
import { getLiveCatalog } from '../../lib/catalog.js';

export const prerender = false;

const next = Astro.url.searchParams.get('next') || '/admin/products';
const { settings } = await getLiveCatalog();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>Sign in · Admin</title>
  </head>
  <body class="min-h-screen bg-cream-50 font-sans antialiased">
    <div class="mx-auto max-w-sm pt-16 text-center">
      <img src="/logo.png" alt="" width="64" height="64" class="mx-auto h-16 w-16 rounded-full" />
      <p class="mt-3 font-display text-2xl font-semibold text-blush-700">{settings.businessName ?? 'Naazique Giftoria'}</p>
      <p class="mt-1 text-sm text-ink-700">Admin sign in</p>
    </div>
    <LoginForm client:load next={next} />
  </body>
</html>
