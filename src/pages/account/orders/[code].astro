---
import Base from '../../../layouts/Base.astro';
import { getLiveCatalog } from '../../../lib/catalog.js';
import { requireCustomerPageSession } from '../../../lib/customerGuard.js';
import { getDb } from '../../../lib/db.js';
import { formatINR } from '../../../lib/money.js';
import type { OrderWithId } from '../../../lib/schemas.js';

export const prerender = false;

const session = await requireCustomerPageSession(Astro);
if (session instanceof Response) return session;

const { settings } = await getLiveCatalog();

const db = await getDb();
const order = await db.collection<OrderWithId>('orders').findOne({ orderCode: Astro.params.code });

// Same response whether the order doesn't exist or belongs to someone else —
// confirming "that order exists but isn't yours" is itself a leak. This is
// the entire reason checkout requires an account: without an ownership
// check like this, anyone who learned an order code could see it.
if (!order || order.customerId !== session.customerId) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const STATUS_LABEL: Record<string, string> = {
  pending: 'Awaiting confirmation', confirmed: 'Confirmed', preparing: 'Preparing', out_for_delivery: 'Out for delivery',
  delivered: 'Delivered', cancelled: 'Cancelled',
};

function fmtDate(d: Date): string {
  return new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
}
---
<Base settings={settings} title={`Order #${order.orderCode}`} noindex description="Your order details.">
  <div class="mx-auto max-w-2xl px-4 py-10 print:py-0">
    <div class="flex items-center justify-between print:hidden">
      <a href="/account" class="text-sm text-ink-700 hover:text-blush-600">← My orders</a>
      <div class="flex gap-2">
        <button id="print-btn" type="button" class="rounded-full border border-blush-200 px-4 py-2 text-sm font-medium text-blush-700 hover:bg-blush-50">
          Print
        </button>
        <a
          href={`/api/account/orders/${order.orderCode}/pdf`}
          class="rounded-full bg-blush-500 px-4 py-2 text-sm font-semibold text-white hover:bg-blush-600"
        >
          Download PDF
        </a>
      </div>
    </div>

    {/* The invoice itself — this block is what ends up printed. */}
    <div class="mt-6 rounded-2xl border border-blush-100 bg-white p-6 sm:p-8 print:rounded-none print:border-0 print:p-0">
      <div class="flex items-start justify-between gap-4 border-b border-blush-100 pb-6">
        <div>
          <p class="font-display text-xl font-semibold text-blush-700">{settings.businessName}</p>
          {settings.deliveryAreas && <p class="mt-1 text-xs text-ink-700">{settings.deliveryAreas}</p>}
          {settings.whatsappNumber && <p class="mt-1 text-xs text-ink-700">WhatsApp: +{settings.whatsappNumber}</p>}
        </div>
        <div class="text-right">
          <p class="text-sm font-semibold text-ink-900">Order #{order.orderCode}</p>
          <p class="mt-1 text-xs text-ink-700">{fmtDate(new Date(order.createdAt))}</p>
          <span class="mt-2 inline-block rounded-full bg-blush-100 px-2.5 py-1 text-xs font-medium text-blush-700">
            {STATUS_LABEL[order.status]}
          </span>
        </div>
      </div>

      <div class="mt-6 grid gap-4 text-sm sm:grid-cols-2">
        <div>
          <p class="font-semibold text-ink-900">Billed to</p>
          <p class="mt-1 text-ink-700">{order.customerName}</p>
          <p class="text-ink-700">+{order.customerPhone}</p>
        </div>
        {order.deliveryAddress && (
          <div>
            <p class="font-semibold text-ink-900">Delivery address</p>
            <p class="mt-1 whitespace-pre-line text-ink-700">{order.deliveryAddress}</p>
            {order.deliveryDate && <p class="mt-1 text-ink-700">Needed by: {order.deliveryDate}</p>}
          </div>
        )}
      </div>

      <table class="mt-8 w-full text-sm">
        <thead>
          <tr class="border-b border-blush-100 text-left text-xs uppercase tracking-wide text-ink-700/70">
            <th class="pb-2 font-medium">Item</th>
            <th class="pb-2 text-right font-medium">Qty</th>
            <th class="pb-2 text-right font-medium">Price</th>
            <th class="pb-2 text-right font-medium">Amount</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-blush-50">
          {order.items.map((item) => (
            <tr>
              <td class="py-2.5 pr-2">
                <p class="text-ink-900">{item.name}</p>
                {item.note && <p class="text-xs text-ink-700/70">{item.note}</p>}
              </td>
              <td class="py-2.5 text-right text-ink-700">{item.qty}</td>
              <td class="py-2.5 text-right text-ink-700">{formatINR(item.price)}</td>
              <td class="py-2.5 text-right font-medium text-ink-900">{formatINR(item.price * item.qty)}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="mt-4 flex justify-end border-t border-blush-100 pt-4">
        <div class="w-40 text-right">
          <p class="text-sm text-ink-700">Total</p>
          <p class="font-display text-2xl font-semibold text-ink-900">{formatINR(order.total)}</p>
        </div>
      </div>

      <p class="mt-8 text-center text-xs text-ink-700/70">
        Thank you for your order! Reach us anytime on WhatsApp for questions about this order.
      </p>
    </div>
  </div>

  <script>
    document.getElementById('print-btn')?.addEventListener('click', () => window.print());
  </script>
</Base>
