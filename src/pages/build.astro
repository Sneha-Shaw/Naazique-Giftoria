---
import Base from '../layouts/Base.astro';
import BouquetBuilder from '../components/BouquetBuilder.jsx';
import { optionGroups, settings } from '../lib/catalog.js';
---
<Base title="Build your own" description="Pick your chocolates, wrap and add-ons — see the price as you go.">
  <div class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="font-display text-3xl font-semibold text-ink-900">Build your own bouquet</h1>
    <p class="mt-2 max-w-2xl text-ink-700">
      Choose what goes in, see the price update as you go, then send it over on WhatsApp. We'll confirm
      it's doable and give you a final quote.
    </p>

    <div class="mt-8">
      <BouquetBuilder
        client:load
        groups={optionGroups}
        basePrice={settings.minOrderValue ?? 500}
      />
    </div>
  </div>
</Base>
